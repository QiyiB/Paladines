# Copia este archivo como .env y completa los valores reales.

# Cadena de conexion a Neon (PostgreSQL serverless)
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Puerto del backend y origen del frontend para CORS
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# Planificador interno de jobs (deudas por vencimiento). false si usas cron externo.
# En Vercel ponlo en false: el cron lo dispara Vercel Cron, no un proceso vivo.
JOBS_EN_PROCESO=true

# Secreto para proteger el endpoint del cron (/api/jobs/generar-deudas).
# En Vercel, define CRON_SECRET y Vercel Cron enviara el header Authorization.
CRON_SECRET=

# Token de Vercel Blob para subir fotos de jugadores.
# Lo obtienes al crear un Blob store en Vercel (Storage -> Blob).
# Sin esto, la subida de fotos responde 503 (el resto de la app funciona igual).
BLOB_READ_WRITE_TOKEN=
